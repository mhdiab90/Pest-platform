{
  "appId": "com.mhdiab90.pestplatform",
  "appName": "Pest Platform",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 60000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": false,
      "statsUrl": ""
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert",
        "banner",
        "list"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_pest_notification",
      "iconColor": "#14517a"
    }
  }
}
