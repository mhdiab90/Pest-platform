{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pest-platform",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-09",
  "keep_vars": true,
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_AGENT_SCHEDULER",
        "class_name": "AIAgentScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AIAgentScheduler"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
