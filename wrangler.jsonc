{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pest-platform",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-09",
  "keep_vars": true,
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_AGENT_SCHEDULER",
        "class_name": "AIAgentScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AIAgentScheduler"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/push/*",
      "/agent",
      "/ask",
      "/execute",
      "/schedules",
      "/dashboards",
      "/whatsapp/*",
      "/drive/*",
      "/attachments*"
    ]
  },
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "AI_AGENT_SCHEDULER",
          "class_name": "AIAgentScheduler"
        }
      ]
    }
  }
}
